<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >
    <xacro:arg name="namespace" default=""/>
    <xacro:property name="prefix" value="$(arg namespace)"/>

    <!-- Orbbec Astra RGB Camera -->
    <gazebo reference="${prefix}camera_link">
        <sensor name="astra_rgb_camera" type="camera">
            <always_on>true</always_on>
            <visualize>true</visualize>
            <update_rate>30</update_rate>
            <topic>${prefix}camera/color/image_raw</topic>
            <gz_frame_id>${prefix}camera_color_frame</gz_frame_id>
            <camera name="orbbec_astra">
                <camera_info_topic>${prefix}camera/color/camera_info</camera_info_topic>
                <horizontal_fov>1.02</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.02</near>
                    <far>10.0</far>
                </clip>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.007</stddev>
                </noise>
            </camera>
        </sensor>
    </gazebo>

    <!-- Orbbec Astra Depth Camera -->
    <gazebo reference="${prefix}camera_link">
        <sensor name="astra_depth_camera" type="depth_camera">
            <always_on>true</always_on>
            <visualize>true</visualize>
            <update_rate>30</update_rate>
            <topic>${prefix}camera/depth/image_raw</topic>
            <gz_frame_id>${prefix}camera_depth_frame</gz_frame_id>
            <camera name="orbbec_astra_depth">
                <camera_info_topic>${prefix}camera/depth/camera_info</camera_info_topic>
                <horizontal_fov>1.02</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R_FLOAT32</format>
                </image>
                <clip>
                    <near>0.1</near>
                    <far>10.0</far>
                </clip>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.01</stddev>
                </noise>
            </camera>
        </sensor>
    </gazebo>

</robot>