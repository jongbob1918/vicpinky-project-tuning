<?xml version="1.0"?>
<launch>
  <!-- Arguments -->
  <arg name="use_sim_time" default="false"/>
  <arg name="localization" default="false"/>
  <arg name="use_lidar" default="true"/>
  <arg name="use_rgbd" default="true"/>
  <arg name="use_filtered_scan" default="true"/>
  
  <!-- Robot Bringup (with sensors) -->
  <include file="$(find-pkg-share vicpinky_bringup)/launch/bringup_rgbd.launch.xml">
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
    <arg name="use_lidar" value="$(var use_lidar)"/>
    <arg name="use_rgbd_camera" value="$(var use_rgbd)"/>
  </include>

  <!-- RTAB-Map SLAM -->
  <include file="$(find-pkg-share vicpinky_navigation)/launch/rtabmap_slam.launch.xml">
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
    <arg name="localization" value="$(var localization)"/>
    <arg name="use_lidar" value="$(var use_lidar)"/>
    <arg name="use_rgbd" value="$(var use_rgbd)"/>
    <arg name="use_filtered_scan" value="$(var use_filtered_scan)"/>
  </include>

</launch>